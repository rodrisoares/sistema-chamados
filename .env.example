# Credenciais do Firebase (Console > Configurações do projeto > Seus apps)
# Copie este arquivo para .env e preencha com os valores do seu projeto.
# Obs.: no Vite as variáveis precisam do prefixo VITE_ e são lidas via
#       import.meta.env. Só entram no bundle após reiniciar o `npm start`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
